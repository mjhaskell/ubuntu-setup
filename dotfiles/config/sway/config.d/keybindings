# bindsym $mod+Shift+t exec $browser --profile-directory=Default --app=https://teams.microsoft.com/v2/

# DOC: System: Launch/start screensaver
bindsym $alt+Ctrl+Z exec screensaver_start
# DOC: System: Stop screensaver
bindsym $alt+Ctrl+Delete exec screensaver_stop

# DOC: Apps: Dismiss notification
bindsym $mod+X exec fnottctl dismiss
# DOC: Apps: Dismiss all notifications
bindsym $mod+Shift+X exec fnottctl dismiss all

### Scratchpad Apps
# $mod+key           Toggle scratchpad window
# $mod+Shift+key     Move scratchpad window to startup location

# DOC: Apps: Launch/start terminal scratchpad
bindsym $mod+N      [app_id="spad_normal"] scratchpad show
# DOC: Apps: Launch/start terminal scratchpad
bindsym $mod+Shift+N exec $term_named "spad_normal"

# Math terminal (ipython3)
# bindsym $mod+m [app_id="spad_math"] scratchpad show
# bindsym $mod+Shift+m exec $term_named "spad_math" python -i -m IPython

# DOC: Nav: Move to scratchpad
bindsym $mod+Minus move to scratchpad
# DOC: Nav: Show scratchpad (cycle)
bindsym $mod+Plus scratchpad show

# DOC: Apps: Show status panel (btm)
bindsym $mod+I [app_id="spad_info"] scratchpad show
# DOC: Apps: Launch/start status panel (btm)
bindsym $mod+Shift+I exec $term_named "spad_info" btm
